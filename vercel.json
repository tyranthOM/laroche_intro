{
  "version": 2,
  "buildCommand": "cd frontend && npm install --include=optional && npm run build",
  "outputDirectory": "frontend/dist",
  "headers": [
    {
      "source": "/menu-items/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/intro.mp4",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://121.241.29.115:5050/api/:path*"
    },
    {
      "source": "/socket.io",
      "destination": "http://121.241.29.115:5050/socket.io/"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "http://121.241.29.115:5050/socket.io/$1"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "http://121.241.29.115:5050/socket.io/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "http://121.241.29.115:5050/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}