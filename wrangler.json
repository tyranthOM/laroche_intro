{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "laroche-web",
  "main": "worker.js",
  "compatibility_date": "2024-09-02",
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "routes": [
    { "pattern": "larochecafe.in/*", "zone_name": "larochecafe.in" },
    { "pattern": "www.larochecafe.in/*", "zone_name": "larochecafe.in" }
  ],
  "assets": {
    "directory": "frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*", "/socket.io/*"]
  }
}
